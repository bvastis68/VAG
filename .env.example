# Copy to .env (git ignores it) and fill in. Never paste these values into a chat.

# From developer.whoop.com -> your app
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Must match a Redirect URL registered on the WHOOP app exactly
WHOOP_REDIRECT_URI=http://localhost:8765/callback

# Your own calendar addresses (comma-separated), so the report knows which attendee is you
MY_EMAILS=
# Domains that count as "internal" (comma-separated), e.g. your firm's email domain
INTERNAL_DOMAINS=

# Written by whoop_auth.py. Leave blank.
WHOOP_ACCESS_TOKEN=
WHOOP_REFRESH_TOKEN=
WHOOP_TOKEN_EXPIRES_AT=
